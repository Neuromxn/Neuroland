// Тема меню питания (согласована с my_theme.rasi и палитрой Catppuccin Mocha)
* {
    background-color:      #1E1E2E;
    background-color-alt:  #181825;
    text-color:            #CDD6F4;
    accent-color:          #dc89fa;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    location:       center;
    width:          30%;
    border-radius:  20px;
    padding:        15px;
}

prompt {
    text-color: @accent-color;
}

entry {
    placeholder: "Меню питания";
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-color-alt;
    border-radius:    10px;
    padding:          10px;
    spacing:          5px;
}

listview {
    background-color: transparent;
    spacing:          6px;
    lines:            5;
}

element {
    padding:       8px;
    border-radius: 8px;
    spacing:       10px;
}

element selected {
    background-color: @accent-color;
    text-color:       #1E1E2E;
}
