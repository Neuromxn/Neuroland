// Конфигурация Rofi для Neuroland
// Все варианты тем, перебираемые вручную, хранятся в ~/.config/rofi/themes/

configuration {
    modi: "drun,run,window";
    icon-theme: "Papirus";
    show-icons: true;
    drun-display-format: "{icon} {name}";
}

/* Активная тема — из домашней директории, работает для любого пользователя */
@theme "~/.config/rofi/themes/spotlight-dark.rasi"
